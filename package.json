{
  "name": "gomoonpos",
  "productName": "GoMoonPOS",
  "version": "0.1.0",
  "author": "LunaHdz96",
  "description": "Punto de venta de escritorio: ventas, inventario, fiados, préstamos y reportes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test test/service.test.cjs",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.gomoon.pos",
    "productName": "GoMoonPOS",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [{
      "provider": "github",
      "owner": "LunaHdz96",
      "repo": "GoMoonPOS"
    }]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "wait-on": "^7.2.0"
  }
}
